# ===========================
# RESOLVA - Environment Config
# ===========================

# Backend API
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8700
DATABASE_URL=sqlite+aiosqlite:///./resolva.db

# AI Provider: mock | openai | local
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# Security & CORS
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_ORIGINS=http://localhost:1420,https://tauri.localhost,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FILE=resolva.log

# ===========================
# Google Gmail OAuth 2.0
# ===========================
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Desktop Application)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ===========================
# Microsoft Outlook / 365 OAuth 2.0 (Microsoft Graph)
# ===========================
# Azure Portal -> Microsoft Entra ID -> App Registrations -> Mobile & Desktop applications
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
