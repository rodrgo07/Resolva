# ===========================
# RESOLVA - Environment Config
# ===========================

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8700
DATABASE_URL=sqlite:///./resolva.db

# AI Provider: mock | openai | local
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048

# Security
SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_ORIGINS=http://localhost:1420,https://tauri.localhost

# Logging
LOG_LEVEL=INFO
LOG_FILE=resolva.log

# Email (future)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
